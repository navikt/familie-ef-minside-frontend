{
    "name": "familie-ef-minside-frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "build": "vite build",
        "typecheck": "tsc --noEmit",
        "lint:biome": "biome check . --error-on-warnings",
        "lint": "npm run lint:biome && npm run typecheck",
        "lint:fix": "biome check . --write",
        "format": "biome format . --write",
        "build:server": "tsc --build server/tsconfig.json --verbose",
        "dev:lokal": "npm run build:server && NODE_ENV=development ENV=localhost node server/backend/server-lokal.js",
        "dev": "npm run build:server && NODE_ENV=development BRUK_DEV_API=true ENV=localhost node server/backend/server-lokal.js",
        "test": "vitest run --exclude '**/build/**'"
    },
    "dependencies": {
        "@navikt/aksel-icons": "8.20.1",
        "@navikt/ds-css": "8.20.1",
        "@navikt/ds-react": "8.20.1",
        "@navikt/ds-tokens": "8.20.1",
        "@navikt/nav-dekoratoren-moduler": "4.5.3",
        "axios": "1.21.0",
        "cookie-parser": "1.4.7",
        "date-fns": "4.4.0",
        "dotenv": "18.0.9",
        "express": "5.3.0",
        "http-proxy-middleware": "4.2.1",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-router-dom": "7.18.5",
        "styled-components": "6.6.0",
        "uuid": "14.0.3",
        "winston": "3.19.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.6",
        "@types/cookie-parser": "1.4.10",
        "@types/express": "5.0.6",
        "@types/node": "26.6.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "typescript": "6.0.3",
        "vite": "8.3.5",
        "vitest": "5.0.5"
    }
}
